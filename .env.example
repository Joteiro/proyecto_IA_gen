# Copiá este archivo como `.env` y completá tus claves.

# --- Embeddings (siempre Gemini) ---
# Obtené una gratis en https://aistudio.google.com/apikey
# El código acepta cualquiera de los dos nombres:
GOOGLE_API_KEY=tu_api_key_de_gemini
# GEMINI_API_KEY=tu_api_key_de_gemini

# --- LLM de chat ---
# "groq" (free tier amplio, recomendado) o "gemini" (~20 req/día en free tier).
LLM_PROVIDER=groq
# Necesaria solo si LLM_PROVIDER=groq. Gratis en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq

# (Opcional) sobrescribir modelos por defecto:
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
